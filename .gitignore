# Code Alarm CLI and plugins — Git ignore

# --- Node / TypeScript --------------------------------------------------------
node_modules/
# tsc's test build. The bundled CLI in cli/dist/ and plugins/*/bin/ IS committed: plugin installs
# copy the repository as it is, with no build step.
cli/build/
# Copied from the repository root by `npm pack` (prepack), so the npm package carries them.
cli/LICENSE
cli/README.md
coverage/
*.tsbuildinfo
npm-debug.log*

# --- Secrets ------------------------------------------------------------------
.env
.env.*
!.env.example
# A code-alarm config holds an ntfy topic and maybe an access token. It lives in the user's config
# folder, never in a repository.
config.json

# --- Editors and OS ------------------------------------------------------------
.idea/
.vscode/
.vs/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# --- Claude Code ---------------------------------------------------------------
.claude/settings.local.json
.claude/worktrees/

# --- Local scratch ------------------------------------------------------------
/.scratch/
